{
  "name": "castel-studio-os",
  "version": "0.1.0",
  "private": true,
  "description": "CASTEL STUDIO — AI Business OS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "jobs": "tsx scripts/run-jobs.ts",
    "db:purge-demo": "tsx scripts/purge-demo.ts",
    "test:db": "DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy && vitest run",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "nodemailer": "^6.10.1",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.24",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "22.x"
  }
}
