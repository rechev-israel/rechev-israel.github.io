# ── Database ──────────────────────────────────────────────
# Local: your Postgres. On Vercel: set automatically when you connect a Neon database
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct, used only for migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/castel_os?schema=public"
# DATABASE_URL_UNPOOLED=""

# ── First-run setup (production) ─────────────────────────
# Any long random string (12+ chars). Unlocks /setup to create the owner account
# while no users exist. Remove it after setup if you like.
SETUP_TOKEN=""

# ── Scheduler (Vercel Cron) ──────────────────────────────
# Long random string. Vercel sends it to /api/cron/daily; without it scheduled automations don't run.
CRON_SECRET=""

# ── Auth ──────────────────────────────────────────────────
# Session lifetime in days
SESSION_TTL_DAYS="14"
# Local only: initial owner account created by `npm run db:seed` (change the password after first login!)
SEED_OWNER_EMAIL="owner@castel.studio"
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Castel Owner"
# Set to "true" to also seed clearly-labelled DEMO records (customers/appointments). Default: no demo data.
SEED_DEMO_DATA="false"

# ── AI providers (optional; features show "Not configured" without them) ──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Optional monthly cap on estimated AI spend in USD (agents stop answering once reached).
AI_MONTHLY_BUDGET_USD=""

# ── Media providers (Phase 4; leave empty until configured) ──
# Creative Studio. Each media type activates only when its provider is configured.
OPENAI_API_KEY=""            # images (OPENAI_IMAGE_MODEL optional, default gpt-image-1)
REPLICATE_API_TOKEN=""       # + choose a model per type ("owner/model" or "owner/model:version"):
REPLICATE_MODEL_IMAGE=""
REPLICATE_MODEL_IMAGE_EDIT=""
REPLICATE_MODEL_VIDEO=""
REPLICATE_MODEL_ANIMATION=""
REPLICATE_MODEL_3D=""
ELEVENLABS_API_KEY=""        # voice-over
ELEVENLABS_VOICE_ID=""
# Digital Twin (only used with the owner's recorded consent):
ELEVENLABS_TWIN_VOICE_ID=""  # the owner's own voice, created in ElevenLabs from the owner's samples
REPLICATE_MODEL_AVATAR=""    # talking-avatar model (portrait + script)

# ── Communications (Phase 3) ─────────────────────────────
SMTP_URL=""
SMTP_FROM="CASTEL STUDIO <no-reply@your-domain>"
# Kill switch: WhatsApp is never sent unless this is exactly "true" (currently OFF — account restriction).
WHATSAPP_SENDING_ENABLED="false"
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Ads (Phase 4) ────────────────────────────────────────
META_ADS_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# ── External booking app: Cali (see CALI_INTEGRATION.md) ──
# Long random secret (32+ chars) shared ONLY with the Cali developer over a private channel.
# Enables the signed endpoint /api/integrations/cali/webhook. Without it the endpoint returns 503.
CALI_WEBHOOK_SECRET=""
EXTERNAL_BOOKING_URL="https://cali-b5f0e.web.app/#/aeKiKr0vCLX"
