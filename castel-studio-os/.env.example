# ── Database ──────────────────────────────────────────────
# Local: your Postgres. On Vercel: set automatically when you connect a Neon database
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct, used only for migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/castel_os?schema=public"
# DATABASE_URL_UNPOOLED=""

# ── First-run setup (production) ─────────────────────────
# Any long random string (12+ chars). Unlocks /setup to create the owner account
# while no users exist. Remove it after setup if you like.
SETUP_TOKEN=""

# ── Auth ──────────────────────────────────────────────────
# Session lifetime in days
SESSION_TTL_DAYS="14"
# Local only: initial owner account created by `npm run db:seed` (change the password after first login!)
SEED_OWNER_EMAIL="owner@castel.studio"
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Castel Owner"
# Set to "true" to also seed clearly-labelled DEMO records (customers/appointments). Default: no demo data.
SEED_DEMO_DATA="false"

# ── AI providers (optional; features show "Not configured" without them) ──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ── Media providers (Phase 4; leave empty until configured) ──
IMAGE_PROVIDER_API_KEY=""
VIDEO_PROVIDER_API_KEY=""
TTS_PROVIDER_API_KEY=""

# ── Communications (Phase 3) ─────────────────────────────
SMTP_URL=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Ads (Phase 4) ────────────────────────────────────────
META_ADS_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# ── External booking app (no public API assumed) ─────────
# The adapter supports CSV import only until an official API/export is confirmed.
EXTERNAL_BOOKING_URL="https://cali-b5f0e.web.app/#/aeKiKr0vCLX"
