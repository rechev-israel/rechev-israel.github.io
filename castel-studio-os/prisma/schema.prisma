// CASTEL STUDIO — AI Business OS
// Multi-branch ready: most business records carry a businessId / branchId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & access ─────────────────────────

enum Role {
  OWNER
  MANAGER
  BARBER
  INSTRUCTOR
  MARKETING
  ACCOUNTANT
  VIEWER
}

model Business {
  dateOverrides     DateOverride[]
  pushSubscriptions PushSubscription[]
  reviews           Review[]
  bookingSettings   BookingSettings?
  timeOff           TimeOff[]
  id                String             @id @default(cuid())
  name              String
  category          String
  city              String
  country           String             @default("IL")
  currency          String             @default("ILS")
  timezone          String             @default("Asia/Jerusalem")
  locale            String             @default("he")
  instagram         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  branches         Branch[]
  users            User[]
  customers        Customer[]
  services         Service[]
  appointments     Appointment[]
  courses          Course[]
  students         Student[]
  leads            Lead[]
  transactions     Transaction[]
  tasks            Task[]
  auditLogs        AuditLog[]
  integrations     Integration[]
  aiConversations  AiConversation[]
  approvals        ApprovalRequest[]
  automations      Automation[]
  messageTemplates MessageTemplate[]
  campaigns        Campaign[]
  knowledgeItems   KnowledgeItem[]
  notifications    Notification[]
  outboundMessages OutboundMessage[]
  contentItems     ContentItem[]
  automationRuns   AutomationRun[]
  syncLogs         SyncLog[]
  brandKit         BrandKit?
  creativeAssets   CreativeAsset[]
  sitePages        SitePage[]
  twinProfile      TwinProfile?
  secrets          IntegrationSecret[]
}

model Branch {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  appointments Appointment[]
  cohorts      Cohort[]
  availability AvailabilityRule[]
}

model User {
  pushSubscriptions PushSubscription[]
  /// Shown as a bookable barber on the public booking page.
  acceptsBookings   Boolean            @default(false)
  timeOff           TimeOff[]          @relation("StaffTimeOff")
  id                String             @id @default(cuid())
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email             String             @unique
  name              String
  passwordHash      String
  role              Role               @default(VIEWER)
  isActive          Boolean            @default(true)
  locale            String             @default("he")
  failedLogins      Int                @default(0)
  /// Per-user dashboard layout: ordered list of visible widget ids.
  dashboardWidgets  Json?
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sessions           Session[]
  auditLogs          AuditLog[]
  appointments       Appointment[]      @relation("StaffAppointments")
  cohortsTaught      Cohort[]           @relation("CohortInstructor")
  tasksAssigned      Task[]             @relation("TaskAssignee")
  approvalsDecided   ApprovalRequest[]  @relation("ApprovalDecider")
  approvalsRequested ApprovalRequest[]  @relation("ApprovalRequester")
  customerNotes      CustomerNote[]
  aiConversations    AiConversation[]
  notifications      Notification[]
  outboundMessages   OutboundMessage[]  @relation("MessageCreator")
  availability       AvailabilityRule[]
}

/// Sessions are stored by SHA-256 hash of the token; the raw token only lives in an HttpOnly cookie.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. customer.create
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────── CRM ─────────────────────────

enum CustomerStatus {
  ACTIVE
  AT_RISK
  LAPSED
  VIP
  BLOCKED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

model Customer {
  devices                  CustomerDevice[]
  haircutProfile           HaircutProfile?
  photos                   CustomerPhoto[]
  vipMembership            VipMembership?
  referralCode             ReferralCode?
  waitlist                 WaitlistEntry[]
  rewards                  LoyaltyReward[]
  id                       String           @id @default(cuid())
  businessId               String
  business                 Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName                String
  lastName                 String?
  phone                    String?
  email                    String?
  birthday                 DateTime?
  gender                   String?
  status                   CustomerStatus   @default(ACTIVE)
  source                   String? // walk-in, instagram, referral, booking-app…
  tags                     String[]
  preferences              String? // preferred cut, products, barber
  marketingConsentSms      ConsentStatus    @default(UNKNOWN)
  marketingConsentEmail    ConsentStatus    @default(UNKNOWN)
  marketingConsentWhatsapp ConsentStatus    @default(UNKNOWN)
  consentUpdatedAt         DateTime?
  externalRef              String? // id in the external booking app, if ever linked
  lastVisitAt              DateTime?
  totalSpent               Decimal          @default(0) @db.Decimal(12, 2)
  visitCount               Int              @default(0)
  archivedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  notes            CustomerNote[]
  outboundMessages OutboundMessage[]
  appointments     Appointment[]
  interactions     Interaction[]
  transactions     Transaction[]
  student          Student?

  @@unique([businessId, phone])
  @@index([businessId, externalRef])
  @@index([businessId, status])
  @@index([businessId, lastVisitAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

enum Channel {
  PHONE
  SMS
  WHATSAPP
  EMAIL
  INSTAGRAM
  IN_PERSON
  OTHER
}

enum Direction {
  INBOUND
  OUTBOUND
}

/// Communication history. OUTBOUND records are logs of what was actually sent (or manually recorded); drafts live in MessageDraft.
model Interaction {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    Channel
  direction  Direction
  summary    String
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([customerId, occurredAt])
}

// ───────────────────────── Booking ─────────────────────────

model Service {
  /// Bookable only during premium hours (e.g. VIP service).
  premiumOnly    Boolean  @default(false)
  /// Offered on the public booking page.
  bookableOnline Boolean  @default(true)
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nameHe         String
  nameEn         String
  durationMin    Int
  price          Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  externalRef    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments Appointment[]
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  /// UNPAID | PAID — manual payment tracking from the calendar.
  paymentStatus    String            @default("UNPAID")
  /// SHA-256 of the customer's private manage link token (online bookings only).
  manageTokenHash  String?           @unique
  /// Live status set by the shop (never invented): "delay" | "ready" | null
  liveStatus       String?
  liveDelayMin     Int?
  liveUpdatedAt    DateTime?
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceId        String?
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId          String?
  staff            User?             @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: SetNull)
  startsAt         DateTime
  endsAt           DateTime
  status           AppointmentStatus @default(SCHEDULED)
  price            Decimal?          @db.Decimal(10, 2)
  source           String            @default("manual") // manual | external-import
  externalRef      String?
  notes            String?
  cancelledAt      DateTime?
  cancelReason     String?
  /// Last time an external system (e.g. Cali) changed this record.
  externalSyncedAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([businessId, source, externalRef])
  @@index([businessId, startsAt])
  @@index([customerId])
}

model AvailabilityRule {
  /// regular | premium (premium = extra hours with a surcharge)
  kind      String  @default("regular")
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     User?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday   Int // 0=Sunday … 6=Saturday
  startTime String // "09:00"
  endTime   String // "20:00"
  isActive  Boolean @default(true)
}

// ───────────────────────── Academy ─────────────────────────

enum CourseFormat {
  GROUP
  PRIVATE_VIP
}

model Course {
  id              String       @id @default(cuid())
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code            String
  nameHe          String
  nameEn          String
  descriptionHe   String?
  descriptionEn   String?
  format          CourseFormat
  lessonCount     Int
  lessonsPerWeek  Int
  /// Duration per lesson in minutes; index 0 = lesson 1.
  lessonDurations Int[]
  price           Decimal      @db.Decimal(10, 2)
  maxStudents     Int
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  cohorts   Cohort[]
  materials CourseMaterial[]
  leads     Lead[]

  @@unique([businessId, code])
}

enum CohortStatus {
  PLANNED
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Cohort {
  id           String       @id @default(cuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  instructorId String?
  instructor   User?        @relation("CohortInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  name         String
  startDate    DateTime
  status       CohortStatus @default(PLANNED)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          String   @id @default(cuid())
  cohortId    String
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  number      Int
  startsAt    DateTime
  durationMin Int
  topic       String?
  createdAt   DateTime @default(now())

  attendance Attendance[]

  @@unique([cohortId, number])
}

enum StudentStatus {
  LEAD
  ENROLLED
  ACTIVE
  GRADUATED
  DROPPED
}

model Student {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String?           @unique
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String?
  phone            String?
  email            String?
  idNumber         String? // optional Israeli ID for certificates — sensitive, never exported by default
  experience       String?
  goals            String?
  status           StudentStatus     @default(ENROLLED)
  /// SHA-256 of the personal portal token (the raw token is shown to the owner once).
  portalTokenHash  String?           @unique
  portalTokenAt    DateTime?
  outboundMessages OutboundMessage[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  enrollments Enrollment[]

  @@index([businessId, status])
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Enrollment {
  id                  String           @id @default(cuid())
  studentId           String
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohortId            String
  cohort              Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  status              EnrollmentStatus @default(PENDING)
  agreedPrice         Decimal          @db.Decimal(10, 2)
  progress            Int              @default(0) // 0-100, instructor-assessed
  certificateIssuedAt DateTime?
  certificateNumber   String?          @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attendance Attendance[]
  payments   Payment[]

  @@unique([studentId, cohortId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Attendance {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       AttendanceStatus
  note         String?
  recordedAt   DateTime         @default(now())

  @@unique([enrollmentId, lessonId])
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  BIT
  PAYBOX
  OTHER
}

model Payment {
  id            String        @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  reference     String?
  note          String?
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
}

model CourseMaterial {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  kind         String // link | pdf | video | note
  url          String?
  body         String?
  lessonNumber Int?
  createdAt    DateTime @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ENROLLED
  LOST
}

model Lead {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  name             String
  phone            String?
  email            String?
  source           String? // landing-page slug, instagram, referral
  message          String?
  status           LeadStatus        @default(NEW)
  consent          Boolean           @default(false)
  /// barbershop | academy
  kind             String            @default("academy")
  nextFollowUpAt   DateTime?
  lostReason       String?
  outboundMessages OutboundMessage[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([businessId, status])
}

// ───────────────────────── Finance ─────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionKind {
  ACTUAL
  ESTIMATE
}

model Transaction {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        TransactionType
  kind        TransactionKind @default(ACTUAL)
  category    String // services, academy, products, rent, supplies, marketing, salaries…
  amount      Decimal         @db.Decimal(12, 2)
  occurredAt  DateTime
  description String?
  method      PaymentMethod?
  customerId  String?
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payment Payment?

  @@index([businessId, occurredAt])
  @@index([businessId, type, kind])
}

// ───────────────────────── Operations ─────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Task {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  details    String?
  status     TaskStatus @default(OPEN)
  priority   Int        @default(2) // 1 high, 2 normal, 3 low
  dueAt      DateTime?
  assigneeId String?
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  source     String     @default("manual") // manual | ai | automation
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ───────────────────────── Integrations ─────────────────────────

enum IntegrationStatus {
  CONNECTED
  NOT_CONFIGURED
  REQUIRES_AUTHORIZATION
  ERROR
}

/// Status of an external provider. Secrets are NOT stored here — they come from environment variables
/// (or, in a later phase, an encrypted secret store).
model Integration {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider    String
  status      IntegrationStatus @default(NOT_CONFIGURED)
  lastCheckAt DateTime?
  lastError   String?
  config      Json?
  updatedAt   DateTime          @updatedAt

  @@unique([businessId, provider])
}

// ───────────────────────── AI & approvals ─────────────────────────

model AiConversation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent      String
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  agent          String?
  content        String
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  /// Estimated cost in USD from list prices (estimate, not an invoice).
  costUsd        Decimal?       @db.Decimal(10, 6)
  error          String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

/// Every external action (send message, publish, spend) is queued here and requires human approval.
model ApprovalRequest {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind             String // message.send | content.publish | ads.spend | data.delete
  title            String
  payload          Json
  status           ApprovalStatus @default(PENDING)
  requestedById    String?
  requestedBy      User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByAgent String?
  decidedById      String?
  decidedBy        User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime       @default(now())

  @@index([businessId, status])
}

model KnowledgeItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  body       String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────────────────── Automation (Phase 3 engine, schema ready) ─────────────────────────

model Automation {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Stable key for built-in workflows (null for user-created ones).
  key         String?
  name        String
  description String?
  trigger     String // see src/server/automation/triggers.ts
  definition  Json // { conditions: Condition[], actions: Action[] }
  isActive    Boolean   @default(false)
  maxRetries  Int       @default(3)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs AutomationRun[]

  @@unique([businessId, key])
}

model AutomationRun {
  id           String     @id @default(cuid())
  businessId   String?
  business     Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String // running | succeeded | skipped | failed | retrying
  attempt      Int        @default(1)
  /// Prevents the same scheduled item being processed twice (e.g. "appt:<id>").
  dedupeKey    String?
  input        Json?
  output       Json?
  steps        Json?
  error        String?
  nextRetryAt  DateTime?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?

  @@unique([automationId, dedupeKey])
  @@index([status, nextRetryAt])
}

model Notification {
  /// Prevents the same event from creating two notifications (e.g. "booking:<id>:created").
  dedupeKey  String?   @unique
  /// Related record (e.g. appointment id) for deep links.
  entityId   String?
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// null = visible to all owners/managers
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // automation | report | ai_insight | system
  level      String    @default("info") // info | warn | success
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId, readAt, createdAt])
}

enum MessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  BLOCKED_NO_CONSENT
}

/// Every outbound customer communication. Nothing leaves the system unless status passes APPROVED
/// and a real provider is configured.
model OutboundMessage {
  /// Values for the WhatsApp template parameters (name, date, time, service…).
  templateVars      Json?
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel           Channel
  /// marketing | transactional
  purpose           String        @default("transactional")
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  studentId         String?
  student           Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  recipientName     String?
  toAddress         String?
  subject           String?
  body              String
  status            MessageStatus @default(PENDING_APPROVAL)
  templateKey       String?
  automationRunId   String?
  scheduledFor      DateTime?
  provider          String?
  providerMessageId String?
  error             String?
  attempts          Int           @default(0)
  approvedById      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  createdById       String?
  createdBy         User?         @relation("MessageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([businessId, status, createdAt])
  @@index([customerId])
}

// ───────────────────────── Communications & marketing (schema ready) ─────────────────────────

model MessageTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key        String?
  purpose    String   @default("transactional")
  isActive   Boolean  @default(true)
  name       String
  channel    Channel
  locale     String   @default("he")
  subject    String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, key, channel, locale])
}

model Campaign {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  objective   String?
  channel     String? // instagram, tiktok, meta-ads, google-ads
  status      String    @default("draft") // draft | pending_approval | approved | live | ended
  budget      Decimal?  @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  plan        Json?
  audience    String?
  /// Manually entered results until ad platforms are connected.
  spendActual Decimal?  @db.Decimal(10, 2)
  impressions Int?
  clicks      Int?
  leads       Int?
  conversions Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contentItems ContentItem[]
}

model ContentItem {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  platform     String // instagram | tiktok | facebook | other
  format       String // post | reel | story | carousel | video
  title        String
  caption      String?
  hashtags     String[]
  scheduledFor DateTime?
  status       String    @default("idea") // idea | draft | pending_approval | approved | published
  notes        String?
  /// Manually entered performance until platforms are connected.
  views        Int?
  likes        Int?
  comments     Int?
  saves        Int?
  leads        Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, scheduledFor])
}

/// One record per sync batch from an external booking system (webhook, CSV or calendar).
model SyncLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source     String // cali
  channel    String // webhook | csv | calendar
  received   Int      @default(0)
  created    Int      @default(0)
  updated    Int      @default(0)
  unchanged  Int      @default(0)
  failed     Int      @default(0)
  errors     Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

/// Brand identity used by the Creative Studio (templates, prompts, AI voice).
model BrandKit {
  id           String   @id @default(cuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  displayName  String   @default("CASTEL STUDIO")
  tagline      String?
  primaryColor String   @default("#0a0a0b")
  accentColor  String   @default("#c9a44c")
  textColor    String   @default("#f2ede3")
  voiceTone    String?
  visualStyle  String?
  hashtags     String[]
  handle       String?  @default("@castel.cutzz")
  updatedAt    DateTime @updatedAt
}

/// Every Creative Studio output: built-in graphics and provider-generated media.
model CreativeAsset {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// graphic | image | image_edit | video | animation | model3d | voiceover
  kind          String
  title         String
  prompt        String?
  /// builtin | openai | replicate | elevenlabs
  provider      String
  model         String?
  /// pending_config | queued | processing | succeeded | failed
  status        String   @default("queued")
  providerJobId String?
  outputUrl     String?
  /// Inline result for small built-in outputs (PNG/JPEG data URL, size-capped).
  dataUrl       String?
  mimeType      String?
  /// draft | pending_approval | approved | rejected
  approval      String   @default("draft")
  error         String?
  meta          Json?
  createdById   String?
  costNote      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId, kind, createdAt])
  @@index([status])
}

/// Website / landing page built from blocks. Draft edits never affect the live page until published.
model SitePage {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  seoTitle        String?
  seoDescription  String?
  blocks          Json
  publishedBlocks Json?
  publishedTitle  String?
  status          String    @default("draft") // draft | published | unpublished
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, slug])
}

/// Owner AI Digital Twin. Nothing in the twin works without explicit, recorded consent.
model TwinProfile {
  id            String    @id @default(cuid())
  businessId    String    @unique
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerName     String
  persona       String?
  consentGiven  Boolean   @default(false)
  consentText   String?
  consentAt     DateTime?
  consentById   String?
  /// Scopes the owner consented to: chat, voice, avatar
  consentScopes String[]
  /// Public https URL of an owner-approved portrait used for avatar video (only with "avatar" consent).
  portraitUrl   String?
  revokedAt     DateTime?
  updatedAt     DateTime  @updatedAt
}

/// Integration credentials entered in the app. Encrypted with AES-256-GCM (key: SECRETS_ENCRYPTION_KEY env var).
/// Plaintext is never stored, logged or sent to the browser; only the last 4 characters are kept for display.
model IntegrationSecret {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  ciphertext  String
  iv          String
  tag         String
  last4       String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([businessId, name])
}

/// Public online booking (replaces the external booking app). One row per business.
model BookingSettings {
  /// Added to the service price for appointments in premium hours (₪).
  premiumSurcharge      Int      @default(0)
  /// Service messages (confirmation, reminder, post-visit, academy) from automations are sent without manual approval.
  autoSendTransactional Boolean  @default(true)
  /// Marketing messages (e.g. birthday) are sent automatically — only to customers who opted in.
  autoSendMarketing     Boolean  @default(false)
  businessId            String   @id
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled               Boolean  @default(false)
  /// true = online bookings are CONFIRMED immediately; false = SCHEDULED, staff confirms.
  autoConfirm           Boolean  @default(true)
  slotStepMin           Int      @default(15)
  minNoticeMin          Int      @default(60)
  maxDaysAhead          Int      @default(30)
  cancelNoticeMin       Int      @default(180)
  bufferMin             Int      @default(0)
  maxActivePerPhone     Int      @default(2)
  noteHe                String?
  noteEn                String?
  updatedAt             DateTime @updatedAt
}

/// Closed periods: holidays (staffId null = whole shop) or a barber's vacation.
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      User?    @relation("StaffTimeOff", fields: [staffId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([businessId, startsAt])
}

/// Web Push subscription of a staff device (owner's phone, desktop browser). Keys are public per the Push API spec.
model PushSubscription {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  lastError     String?
  failures      Int       @default(0)

  @@index([businessId])
}

/// A customer's own phone/browser that booked online. The device keeps a random key (only its SHA-256 is stored here)
/// that lets it open "My appointments" on the public website without a password.
model CustomerDevice {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([customerId])
}

/// Hours for one specific date (holiday eve, extra day…) replacing the weekly schedule. staffId null = whole shop.
model DateOverride {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId    String?
  /// YYYY-MM-DD (business timezone)
  date       String
  closed     Boolean  @default(false)
  /// [{ start: "09:00", end: "13:00", kind: "regular" | "premium" }]
  windows    Json     @default("[]")
  note       String?
  createdAt  DateTime @default(now())

  @@unique([businessId, staffId, date])
  @@index([businessId, date])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

/// A customer's star review, left from the website with their private booking link (one per appointment).
model Review {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  appointmentId String?      @unique
  name          String
  rating        Int
  text          String?
  /// Optional ratings and private notes (never shown on the website).
  serviceRating Int?
  suggestion    String?
  /// The customer agreed to show this review on the website.
  publicConsent Boolean      @default(true)
  /// Left after a completed visit.
  verified      Boolean      @default(false)
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, status, createdAt])
}

// ───────────────────────── Customer experience (MY CASTEL) ─────────────────────────

/// Owner-controlled programs. Everything is OFF until the owner turns it on.
model ExperienceSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  club       Json     @default("{}")
  vip        Json     @default("{}")
  referral   Json     @default("{}")
  reminders  Json     @default("{}")
  surprise   Json     @default("{}")
  gifts      Json     @default("{}")
  model      Json     @default("{}")
  updatedAt  DateTime @updatedAt
}

/// A reward a customer earned (CASTEL CLUB visits, or a referral). refKey makes each one unique — no double rewards.
model LoyaltyReward {
  id           String    @id @default(cuid())
  businessId   String
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// club | referral
  kind         String
  refKey       String    @unique
  label        String
  /// AVAILABLE | REDEEMED | EXPIRED | VOID
  status       String    @default("AVAILABLE")
  earnedAt     DateTime  @default(now())
  expiresAt    DateTime?
  redeemedAt   DateTime?
  redeemedById String?
  /// Surprise rewards: the benefit is assigned on the server; the scratch card only reveals it.
  revealedAt   DateTime?

  @@index([customerId, status])
}

/// "MY HAIRCUT": what the customer likes. Visible to the shop's staff (that's its purpose).
model HaircutProfile {
  id         String   @id @default(cuid())
  businessId String
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  style      String?
  fade       String?
  guards     String?
  topLength  String?
  beard      String?
  styling    String?
  notes      String?
  photoId    String?
  updatedAt  DateTime @updatedAt
}

/// "MY LOOKS": private photos. Staff see a photo only when the customer shares it.
model CustomerPhoto {
  id               String   @id @default(cuid())
  businessId       String
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mime             String
  data             Bytes
  bytes            Int
  note             String?
  favorite         Boolean  @default(false)
  sharedWithBarber Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([customerId, createdAt])
}

model VipMembership {
  id         String   @id @default(cuid())
  businessId String
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// ACTIVE | REVOKED
  status     String   @default("ACTIVE")
  /// MANUAL | AUTO
  source     String   @default("MANUAL")
  note       String?
  since      DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ReferralCode {
  id         String   @id @default(cuid())
  businessId String
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code       String   @unique
  createdAt  DateTime @default(now())
}

/// One referral per new customer (referredId is unique).
model Referral {
  id            String    @id @default(cuid())
  businessId    String
  referrerId    String
  referredId    String    @unique
  appointmentId String?
  /// PENDING | QUALIFIED | REJECTED
  status        String    @default("PENDING")
  reason        String?
  qualifiedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([referrerId])
}

model WaitlistEntry {
  id         String    @id @default(cuid())
  businessId String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  /// Preferred date first, then acceptable alternatives (YYYY-MM-DD).
  dates      String[]
  fromMin    Int
  toMin      Int
  /// portal | whatsapp
  notify     String    @default("portal")
  /// ACTIVE | NOTIFIED | BOOKED | LEFT | EXPIRED
  status     String    @default("ACTIVE")
  matchDate  String?
  matchStart Int?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId, status])
}

/// One reminder per appointment, kind and start time (a moved appointment gets a fresh reminder).
model AppointmentReminder {
  id            String   @id @default(cuid())
  businessId    String
  appointmentId String
  kind          String
  startsAtKey   String
  /// sent | skipped_not_connected | blocked_no_consent | failed
  outcome       String
  messageId     String?
  createdAt     DateTime @default(now())

  @@unique([appointmentId, kind, startsAtKey])
}

/// "Special requests" for one existing appointment (never changes its duration or price).
model AppointmentRequest {
  id            String   @id @default(cuid())
  businessId    String
  appointmentId String   @unique
  customerId    String
  style         String?
  fade          String?
  beard         String?
  changes       String?
  note          String?
  photoId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Digital gift cards. A code exists only after the owner confirms payment; redeemed once.
model GiftCard {
  id              String    @id @default(cuid())
  businessId      String
  /// REQUESTED | ACTIVE | REDEEMED | CANCELLED | EXPIRED
  status          String    @default("REQUESTED")
  /// service | amount
  kind            String
  serviceId       String?
  serviceName     String?
  amount          Int?
  recipientName   String
  message         String?
  design          String    @default("noir")
  buyerName       String
  buyerPhone      String
  buyerCustomerId String?
  viewTokenHash   String    @unique
  code            String?   @unique
  paidAt          DateTime?
  paidById        String?
  expiresAt       DateTime?
  redeemedAt      DateTime?
  redeemedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId, status])
}

/// CASTEL MODEL EXPERIENCE: a hair-model application (free, 120 min). Never an appointment until the owner approves.
model ModelApplication {
  id              String    @id @default(cuid())
  businessId      String
  customerId      String
  /// Requested day in Asia/Jerusalem (YYYY-MM-DD)
  dayKey          String
  /// Set while the application holds its day (pending / approved / completed); null once released.
  /// Unique per business → one model per calendar day, enforced by the database itself.
  activeDay       String?
  startsAt        DateTime
  endsAt          DateTime
  /// PENDING_APPROVAL | APPROVED | REJECTED | ALT_PROPOSED | CANCELLED | EXPIRED
  status          String    @default("PENDING_APPROVAL")
  notes           String?
  photoFrontId    String?
  photoSideId     String?
  photoBackId     String?
  consentTerms    Boolean   @default(false)
  consentPhotos   Boolean   @default(false)
  /// The temporary two-hour calendar hold (TimeOff) while pending
  holdId          String?
  appointmentId   String?   @unique
  rejectReason    String?
  altStartsAt     DateTime?
  manageTokenHash String    @unique
  expiresAt       DateTime
  decidedAt       DateTime?
  decidedById     String?
  photosDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, activeDay])
  @@index([businessId, status, startsAt])
  @@index([customerId])
}
