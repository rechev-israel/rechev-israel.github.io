// CASTEL STUDIO — AI Business OS
// Multi-branch ready: most business records carry a businessId / branchId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & access ─────────────────────────

enum Role {
  OWNER
  MANAGER
  BARBER
  INSTRUCTOR
  MARKETING
  ACCOUNTANT
  VIEWER
}

model Business {
  id        String   @id @default(cuid())
  name      String
  category  String
  city      String
  country   String   @default("IL")
  currency  String   @default("ILS")
  timezone  String   @default("Asia/Jerusalem")
  locale    String   @default("he")
  instagram String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches       Branch[]
  users          User[]
  customers      Customer[]
  services       Service[]
  appointments   Appointment[]
  courses        Course[]
  students       Student[]
  leads          Lead[]
  transactions   Transaction[]
  tasks          Task[]
  auditLogs      AuditLog[]
  integrations   Integration[]
  aiConversations AiConversation[]
  approvals      ApprovalRequest[]
  automations    Automation[]
  messageTemplates MessageTemplate[]
  campaigns      Campaign[]
  knowledgeItems KnowledgeItem[]
}

model Branch {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  appointments Appointment[]
  cohorts      Cohort[]
  availability AvailabilityRule[]
}

model User {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  locale       String    @default("he")
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  appointments    Appointment[] @relation("StaffAppointments")
  cohortsTaught   Cohort[]      @relation("CohortInstructor")
  tasksAssigned   Task[]        @relation("TaskAssignee")
  approvalsDecided ApprovalRequest[] @relation("ApprovalDecider")
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  customerNotes   CustomerNote[]
  aiConversations AiConversation[]
  availability    AvailabilityRule[]
}

/// Sessions are stored by SHA-256 hash of the token; the raw token only lives in an HttpOnly cookie.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. customer.create
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────── CRM ─────────────────────────

enum CustomerStatus {
  ACTIVE
  AT_RISK
  LAPSED
  VIP
  BLOCKED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

model Customer {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String?
  phone          String?
  email          String?
  birthday       DateTime?
  gender         String?
  status         CustomerStatus @default(ACTIVE)
  source         String? // walk-in, instagram, referral, booking-app…
  tags           String[]
  preferences    String? // preferred cut, products, barber
  marketingConsentSms      ConsentStatus @default(UNKNOWN)
  marketingConsentEmail    ConsentStatus @default(UNKNOWN)
  marketingConsentWhatsapp ConsentStatus @default(UNKNOWN)
  consentUpdatedAt DateTime?
  externalRef    String? // id in the external booking app, if ever linked
  lastVisitAt    DateTime?
  totalSpent     Decimal        @default(0) @db.Decimal(12, 2)
  visitCount     Int            @default(0)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notes         CustomerNote[]
  appointments  Appointment[]
  interactions  Interaction[]
  transactions  Transaction[]
  student       Student?

  @@unique([businessId, phone])
  @@index([businessId, status])
  @@index([businessId, lastVisitAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

enum Channel {
  PHONE
  SMS
  WHATSAPP
  EMAIL
  INSTAGRAM
  IN_PERSON
  OTHER
}

enum Direction {
  INBOUND
  OUTBOUND
}

/// Communication history. OUTBOUND records are logs of what was actually sent (or manually recorded); drafts live in MessageDraft.
model Interaction {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    Channel
  direction  Direction
  summary    String
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([customerId, occurredAt])
}

// ───────────────────────── Booking ─────────────────────────

model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nameHe      String
  nameEn      String
  durationMin Int
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId     String?
  staff       User?             @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: SetNull)
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus @default(SCHEDULED)
  price       Decimal?          @db.Decimal(10, 2)
  source      String            @default("manual") // manual | external-import
  externalRef String?
  notes       String?
  cancelledAt DateTime?
  cancelReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId, startsAt])
  @@index([customerId])
}

model AvailabilityRule {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     User?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday   Int // 0=Sunday … 6=Saturday
  startTime String // "09:00"
  endTime   String // "20:00"
  isActive  Boolean @default(true)
}

// ───────────────────────── Academy ─────────────────────────

enum CourseFormat {
  GROUP
  PRIVATE_VIP
}

model Course {
  id              String       @id @default(cuid())
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code            String
  nameHe          String
  nameEn          String
  descriptionHe   String?
  descriptionEn   String?
  format          CourseFormat
  lessonCount     Int
  lessonsPerWeek  Int
  /// Duration per lesson in minutes; index 0 = lesson 1.
  lessonDurations Int[]
  price           Decimal      @db.Decimal(10, 2)
  maxStudents     Int
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  cohorts   Cohort[]
  materials CourseMaterial[]
  leads     Lead[]

  @@unique([businessId, code])
}

enum CohortStatus {
  PLANNED
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Cohort {
  id           String       @id @default(cuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  instructorId String?
  instructor   User?        @relation("CohortInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  name         String
  startDate    DateTime
  status       CohortStatus @default(PLANNED)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          String   @id @default(cuid())
  cohortId    String
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  number      Int
  startsAt    DateTime
  durationMin Int
  topic       String?
  createdAt   DateTime @default(now())

  attendance Attendance[]

  @@unique([cohortId, number])
}

enum StudentStatus {
  LEAD
  ENROLLED
  ACTIVE
  GRADUATED
  DROPPED
}

model Student {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?       @unique
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName  String
  lastName   String?
  phone      String?
  email      String?
  idNumber   String? // optional Israeli ID for certificates — sensitive, never exported by default
  experience String?
  goals      String?
  status     StudentStatus @default(ENROLLED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  enrollments Enrollment[]

  @@index([businessId, status])
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohortId    String
  cohort      Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(PENDING)
  agreedPrice Decimal          @db.Decimal(10, 2)
  progress    Int              @default(0) // 0-100, instructor-assessed
  certificateIssuedAt DateTime?
  certificateNumber   String?   @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  attendance Attendance[]
  payments   Payment[]

  @@unique([studentId, cohortId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Attendance {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       AttendanceStatus
  note         String?
  recordedAt   DateTime         @default(now())

  @@unique([enrollmentId, lessonId])
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  BIT
  PAYBOX
  OTHER
}

model Payment {
  id           String        @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  paidAt       DateTime      @default(now())
  reference    String?
  note         String?
  transactionId String?      @unique
  transaction  Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
}

model CourseMaterial {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  kind      String // link | pdf | video | note
  url       String?
  body      String?
  lessonNumber Int?
  createdAt DateTime @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ENROLLED
  LOST
}

model Lead {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  name       String
  phone      String?
  email      String?
  source     String? // landing-page slug, instagram, referral
  message    String?
  status     LeadStatus @default(NEW)
  consent    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([businessId, status])
}

// ───────────────────────── Finance ─────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionKind {
  ACTUAL
  ESTIMATE
}

model Transaction {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        TransactionType
  kind        TransactionKind @default(ACTUAL)
  category    String // services, academy, products, rent, supplies, marketing, salaries…
  amount      Decimal         @db.Decimal(12, 2)
  occurredAt  DateTime
  description String?
  method      PaymentMethod?
  customerId  String?
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payment Payment?

  @@index([businessId, occurredAt])
  @@index([businessId, type, kind])
}

// ───────────────────────── Operations ─────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Task {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  details    String?
  status     TaskStatus @default(OPEN)
  priority   Int        @default(2) // 1 high, 2 normal, 3 low
  dueAt      DateTime?
  assigneeId String?
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  source     String     @default("manual") // manual | ai | automation
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ───────────────────────── Integrations ─────────────────────────

enum IntegrationStatus {
  CONNECTED
  NOT_CONFIGURED
  REQUIRES_AUTHORIZATION
  ERROR
}

/// Status of an external provider. Secrets are NOT stored here — they come from environment variables
/// (or, in a later phase, an encrypted secret store).
model Integration {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider    String
  status      IntegrationStatus @default(NOT_CONFIGURED)
  lastCheckAt DateTime?
  lastError   String?
  config      Json?
  updatedAt   DateTime          @updatedAt

  @@unique([businessId, provider])
}

// ───────────────────────── AI & approvals ─────────────────────────

model AiConversation {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent      String
  title      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  messages AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  agent          String?
  content        String
  provider       String?
  model          String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

/// Every external action (send message, publish, spend) is queued here and requires human approval.
model ApprovalRequest {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind        String // message.send | content.publish | ads.spend | data.delete
  title       String
  payload     Json
  status      ApprovalStatus @default(PENDING)
  requestedById String?
  requestedBy User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByAgent String?
  decidedById String?
  decidedBy   User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime       @default(now())

  @@index([businessId, status])
}

model KnowledgeItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  body       String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────────────────── Automation (Phase 3 engine, schema ready) ─────────────────────────

model Automation {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  trigger     String // customer.created | appointment.completed | lead.created | schedule.weekly
  definition  Json // { conditions: [], actions: [] }
  isActive    Boolean  @default(false)
  maxRetries  Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs AutomationRun[]
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String // queued | running | succeeded | failed | awaiting_approval
  attempt      Int        @default(1)
  input        Json?
  output       Json?
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
}

// ───────────────────────── Communications & marketing (schema ready) ─────────────────────────

model MessageTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  channel    Channel
  locale     String   @default("he")
  subject    String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Campaign {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  objective  String?
  channel    String? // instagram, tiktok, meta-ads, google-ads
  status     String   @default("draft") // draft | pending_approval | approved | live | ended
  budget     Decimal? @db.Decimal(10, 2)
  startsAt   DateTime?
  endsAt     DateTime?
  plan       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
